{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
